{
  "manifest_version": 3,
  "name": "招聘 JD 抓取助手 (BOSS+智联)",
  "version": "1.2.0",
  "description": "在 BOSS直聘 / 智联招聘 岗位页一键抓取 JD 全文到本地，自动去重，供求职分析使用",
  "permissions": ["storage", "downloads"],
  "host_permissions": ["https://www.zhipin.com/*", "https://*.zhipin.com/*", "https://*.zhaopin.com/*", "https://www.zhaopin.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "JD 抓取助手",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.zhipin.com/*", "https://*.zhipin.com/*"],
      "js": ["intercept.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.zhipin.com/*", "https://*.zhipin.com/*", "https://*.zhaopin.com/*", "https://www.zhaopin.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
